    "settings_reminder_notif_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your book is waiting. A quiet page or two?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的书在等你。读上一两页吧？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的書在等你。讀上一兩頁吧？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本が待っています。静かに1、2ページいかがですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책이 기다리고 있어요. 조용히 한두 페이지 어떠세요?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu libro te espera. ¿Una página o dos?"
          }
        },
