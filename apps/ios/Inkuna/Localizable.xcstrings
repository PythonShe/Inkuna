    "themepick_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read by day, or by night"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论白昼，亦或深夜"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論白晝，抑或深夜"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昼の光のなかで、あるいは夜の静けさのなかで"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮의 빛 아래에서, 혹은 밤의 고요 속에서"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lectura de día o de noche"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire de jour comme de nuit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi di giorno, o di notte"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтение днем и ночью"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านในยามกลางวัน หรือยามค่ำคืน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc lúc ban ngày, hoặc khi đêm về"
          }
        }
      }
    },
    "themepick_sample": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lamp burned low, and the moon took over the work of lighting the page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯火微熹，月色接替了照亮书页的微光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "燈火微熹，月色接替了照亮書頁的微光。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランプの灯が落ち、月がページを照らしはじめる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "램프의 불빛이 잦아들자, 달빛이 책장을 비추기 시작했다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lámpara tenue menguaba y la luna se hizo cargo de iluminar la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lampe faiblissait et la lune prit le relais pour éclairer la page."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lampada si affievoliva e la luna prese il compito di illuminare la pagina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лампа догорала, и луна взяла на себя заботу освещать страницу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตะเกียงหรี่แสงลง และดวงจันทร์เข้ามารับหน้าที่ส่องสว่างบนหน้ากระดาษแทน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngọn đèn lụi dần, và vầng trăng tiếp tục công việc soi sáng trang sách."
          }
        }
      }
    },
    "themepick_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this anytime while reading."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读时可随时更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閱讀時可隨時更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定は読書中いつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독서 중에 언제든지 변경할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar esto en cualquier momento durante la lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez modifier cela à tout moment pendant la lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi modificarlo in qualsiasi momento durante la lettura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете изменить это в любой момент во время чтения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถเปลี่ยนค่านี้ได้ตลอดเวลาขณะอ่าน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể thay đổi bất kỳ lúc nào khi đang đọc sách."
          }
        }
      }
    },
