    "welcome_tagline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clean, minimalist book reader."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "极简纯粹的电子书阅读器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "極簡純粹的電子書閱讀器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シンプルで洗練された電子書籍リーダー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심플하고 깔끔한 미니멀 전자책 리더."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lector de libros minimalista y elegante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lecteur de livres minimaliste et épuré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lettore di libri essenziale ed elegante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минималистичное и удобное приложение для чтения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปอ่านหนังสือสไตล์มินิมอลที่เรียบง่าย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình đọc sách điện tử tối giản và thanh lịch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein minimalistischer und eleganter E-Book-Reader."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaca e-book minimalis yang bersih dan elegan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um leitor de livros minimalista e elegante."
          }
        }
