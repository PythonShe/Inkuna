    "welcome_tagline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A minimalist book reader where ink meets moonlight."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墨水与月光相遇的极简阅读器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "墨水與月光相遇的極簡閱讀器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インクと月光が巡り会う、静謐な読書体験。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잉크와 달빛이 만나는 미니멀한 독서 공간."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lector de libros minimalista donde la tinta se funde con la luz de la luna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lecteur de livres minimaliste où l'encre rencontre le clair de lune."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lettore di libri essenziale dove l'inchiostro incontra il chiaro di luna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минималистичная читалка, где чернила встречаются с лунным светом."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปอ่านหนังสือสไตล์มินิมอล ที่ซึ่งน้ำหมึกบรรจบกับแสงจันทร์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình đọc sách tối giản, nơi trang mực hòa cùng ánh trăng."
          }
        }
      }
    },
