    "import_fail_storage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file couldn't be read. Check that it's still available and that this device has room."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取文件。请检查文件是否可用以及设备存储空间是否充足。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取檔案。請檢查檔案是否可用以及裝置儲存空間是否充足。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
