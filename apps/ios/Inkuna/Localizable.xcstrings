    "import_fail_broken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This book can't be opened. It may be incomplete — or protected by DRM, which Inkuna doesn't support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开此书籍。文件可能不完整，或受 Inkuna 不支持的 DRM 保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟此書籍。檔案可能不完整，或受 Inkuna 不支援的 DRM 保護。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書籍を開けません。ファイルが不完全であるか、Inkunaが対応していないDRMで保護されている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 도서를 열 수 없습니다. 파일이 불완전하거나 Inkuna에서 지원하지 않는 DRM으로 보호되어 있을 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede abrir este libro. Puede que esté incompleto o protegido por DRM, que Inkuna no admite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'ouvrir ce livre. Il est peut-être incomplet ou protégé par des DRM non pris en charge par Inkuna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire questo libro. Potrebbe essere incompleto o protetto da DRM, che Inkuna non supporta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть эту книгу. Возможно, файл повреждён или защищён DRM, которую Inkuna не поддерживает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเปิดหนังสือเล่มนี้ได้ ไฟล์อาจไม่สมบูรณ์ หรือได้รับการป้องกันด้วย DRM ซึ่ง Inkuna ไม่รองรับ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể mở sách này. Tệp có thể không đầy đủ hoặc được bảo vệ bằng DRM mà Inkuna không hỗ trợ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Buch kann nicht geöffnet werden. Es ist möglicherweise unvollständig oder durch DRM geschützt, was Inkuna nicht unterstützt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buku ini tidak dapat dibuka. Mungkin tidak lengkap atau dilindungi DRM yang tidak didukung Inkuna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
