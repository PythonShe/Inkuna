    "import_empty_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a book from Files, iCloud Drive, or wherever your books live. Inkuna keeps its own copy, so the original stays where it is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“文件”、iCloud 云盘或存放书籍的位置添加书籍。Inkuna 会保留独立副本，不影响原文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從「檔案」、iCloud 雲碟或存放書籍的位置加入書籍。Inkuna 會保留獨立複本，不影響原始檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ファイル」やiCloud Driveなどから書籍を追加すると、ここに並びます。Inkuna内に複製されるため、元のファイルはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'파일', iCloud Drive 등에서 도서를 추가하면 이곳에 보관됩니다. Inkuna는 자체 복사본을 유지하므로 원본 파일은 그대로 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un libro desde Archivos, iCloud Drive o donde guardes tus libros. Inkuna guarda su propia copia, por lo que el original permanece donde está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un livre depuis Fichiers, iCloud Drive ou tout autre emplacement. Inkuna conserve sa propre copie, laissant l'original intact."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un libro da File, iCloud Drive o ovunque siano i tuoi libri. Inkuna ne conserva una copia separata, lasciando intatto l'originale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте книгу из «Файлов», iCloud Drive или другого хранилища. Inkuna сохраняет отдельную копию, не меняя оригинал."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มหนังสือจากแอปไฟล์, iCloud Drive หรือแหล่งเก็บหนังสือของคุณ แล้วหนังสือจะมารออยู่ที่นี่ Inkuna จะเก็บสำเนาแยกต่างหาก ไฟล์ต้นฉบับจึงยังคงอยู่ที่เดิม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm sách từ Tệp, iCloud Drive hoặc bất kỳ nơi lưu trữ nào. Inkuna giữ một bản sao riêng, nên tệp gốc vẫn được giữ nguyên vẹn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie ein Buch aus „Dateien“, iCloud Drive oder von einem anderen Ort hinzu. Inkuna legt eine eigene Kopie an; das Original bleibt, wo es ist."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan buku dari File, iCloud Drive, atau tempat buku Anda berada. Inkuna menyimpan salinannya sendiri, jadi file asli tetap di tempatnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um livro de Arquivos, iCloud Drive ou de onde seus livros estiverem. A Inkuna guarda uma cópia própria, então o original fica onde está."
          }
        }
      }
    },
    "import_empty_footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EPUB, MOBI, AZW3, and TXT today. Comics to come."
