          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "EPUB, MOBI, AZW3, dan TXT hari ini. Komik dan lainnya menyusul."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "EPUB, MOBI, AZW3 e TXT hoje. Quadrinhos e mais por vir."
          }
        }
