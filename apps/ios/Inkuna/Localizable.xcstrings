    "themepick_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read by day, or by night"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择日间或夜间阅读模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇日間或夜間閱讀模式"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日中や夜間に合わせた読書モード"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮이나 밤에 맞춘 독서 모드"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lectura de día o de noche"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire de jour comme de nuit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi di giorno o di notte"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтение днем и ночью"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านในเวลากลางวันหรือกลางคืน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc sách ban ngày hoặc ban đêm"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagsüber oder nachts lesen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca di siang atau malam hari"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia de dia ou de noite"
          }
        }
      }
    },
    "themepick_sample": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lamp burned low, and the moon took over the work of lighting the page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯光渐暗，月光洒在书页上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "燈光漸暗，月光灑在書頁上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灯りが落ち着き、月明かりがページを照らし出す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조명이 어두워지자 달빛이 책장을 비추었다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz se atenúa y la luna ilumina la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière baisse et la lune éclaire la page."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La luce si affievolisce e la luna illumina la pagina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свет гаснет, и луна освещает страницу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสงไฟหรี่ลง และแสงจันทร์ส่องสว่างบนหน้ากระดาษ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ánh đèn dịu dần và ánh trăng soi sáng trang sách."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Licht wird gedimmt und der Mond erhellt die Seite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu meredup dan cahaya bulan menerangi halaman."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A luz diminui e a lua ilumina a página."
          }
        }
      }
    },
    "themepick_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this anytime while reading."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读时可随时更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閱讀時可隨時更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定は読書中いつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독서 중에 언제든지 변경할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar esto en cualquier momento durante la lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez modifier cela à tout moment pendant la lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi modificarlo in qualsiasi momento durante la lettura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете изменить это в любой момент во время чтения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถเปลี่ยนค่านี้ได้ตลอดเวลาขณะอ่าน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể thay đổi bất kỳ lúc nào khi đang đọc sách."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können dies jederzeit beim Lesen ändern."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat mengubahnya kapan saja saat membaca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode mudar isso a qualquer momento durante a leitura."
          }
        }
      }
    },
