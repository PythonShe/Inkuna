    "import_fail_unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ files aren't supported yet — Inkuna reads EPUB, MOBI, AZW3, and TXT today."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持 %@ 格式 — Inkuna 当前支持 EPUB、MOBI、AZW3 与 TXT。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
