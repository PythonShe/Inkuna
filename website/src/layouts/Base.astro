---
// Shared shell for every page: theme tokens (ink on paper / moonlight),
// reset, literary serif stack with CJK fallbacks, favicon, link styles.
// Pages bring their own scoped <style> for everything else.
interface Props {
  title: string;
  description?: string;
  /** Page language; CJK inline text still needs its own lang= spans. */
  lang?: string;
  /** Center content in the viewport (error pages) instead of column flow. */
  centered?: boolean;
  noindex?: boolean;
  /** Render Open Graph tags with this title/description. */
  og?: { title: string; description: string };
}

const {
  title,
  description,
  lang = "en",
  centered = false,
  noindex = false,
  og,
} = Astro.props;

const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='42' fill='%231a1a1e'/%3E%3Ccircle cx='66' cy='38' r='26' fill='%23f5f2ea'/%3E%3C/svg%3E";
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {
      og && (
        <>
          <meta property="og:title" content={og.title} />
          <meta property="og:description" content={og.description} />
          <meta property="og:url" content={Astro.site} />
          <meta property="og:type" content="website" />
        </>
      )
    }
    <link rel="icon" href={favicon} />
  </head>
  <body class:list={{ centered }}>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --paper: #f5f2ea;
    --ink: #1a1a1e;
    --ink-soft: #55524c;
    --hairline: rgba(26, 26, 30, 0.18);
    --accent: rgba(26, 26, 30, 0.06);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #121216;
      --ink: #e8e4da;
      --ink-soft: #9b978e;
      --hairline: rgba(232, 228, 218, 0.2);
      --accent: rgba(232, 228, 218, 0.05);
    }
  }
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    background: var(--paper);
    color: var(--ink);
    font-family:
      "Iowan Old Style", "Palatino Nova", Palatino, "Songti SC",
      "Hiragino Mincho ProN", "Yu Mincho", Georgia, serif;
    line-height: 1.65;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  body.centered {
    display: grid;
    place-content: center;
    text-align: center;
    padding: 1.5rem;
  }
  a {
    color: inherit;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  a:hover {
    text-decoration-thickness: 2px;
  }
</style>
