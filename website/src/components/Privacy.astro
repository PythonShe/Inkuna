---
// The privacy policy page, shared by every locale.
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../layouts/Base.astro";
import Footer from "./Footer.astro";
import { type Lang } from "../i18n/locales";
import { privacy } from "../i18n/privacy";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(privacy, lang);
---

<Base
  title={t("meta.title")}
  description={t("meta.description")}
  lang={lang}
  og={{ title: t("meta.title"), description: t("meta.description") }}
  localizedPath="/privacy"
>
  <main>
    <a class="brand" href={getRelativeLocaleUrl(lang, "/")}>Inkuna</a>
    <h1>{t("h1")}</h1>
    <p class="updated">{t("updated")}</p>
    <p class="intro">{t("intro")}</p>

    <section>
      <h2>{t("summary.h")}</h2>
      <p>{t("summary.p")}</p>
    </section>
    <section>
      <h2>{t("collect.h")}</h2>
      <p>{t("collect.p")}</p>
    </section>
    <section>
      <h2>{t("practices.h")}</h2>
      <p>{t("practices.p")}</p>
    </section>
    <section>
      <h2>{t("reading.h")}</h2>
      <p>{t("reading.p")}</p>
    </section>
    <section>
      <h2>{t("website.h")}</h2>
      <p>{t("website.p")}</p>
    </section>
    <section>
      <h2>{t("changes.h")}</h2>
      <p>{t("changes.p")}</p>
    </section>
    <section class="contact">
      <h2>{t("contact.h")}</h2>
      <p>{t("contact.p")}</p>
      <a class="button" href="https://github.com/PythonShe/Inkuna/issues"
        >{t("contact.link")}</a
      >
    </section>
  </main>
  <Footer lang={lang} path="/privacy" />
</Base>

<style>
  main {
    flex: 1;
    width: 100%;
    max-width: 40rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 3rem;
  }
  .brand {
    font-size: 0.95rem;
    color: var(--ink-soft);
    text-decoration: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .brand:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  h1 {
    font-size: clamp(1.9rem, 6vw, 2.6rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    margin: 0.75rem 0 0.5rem;
  }
  .updated {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin-bottom: 1.25rem;
  }
  .intro {
    color: var(--ink-soft);
    font-size: 1.05rem;
    font-style: italic;
    margin-bottom: 3rem;
  }
  /* CJK has no true italics; synthetic oblique looks wrong */
  .intro:lang(ja),
  .intro:lang(zh) {
    font-style: normal;
  }
  section {
    padding: 1.5rem 0;
    border-top: 1px solid var(--hairline);
  }
  section h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.6rem;
  }
  section p {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .contact p {
    margin-bottom: 1.25rem;
  }
  .button {
    display: inline-block;
    border: 1px solid var(--ink);
    border-radius: 0.5rem;
    padding: 0.5rem 1.1rem;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .button:hover {
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
  }
  @media (min-width: 46rem) {
    main {
      padding-top: 5rem;
    }
  }
</style>
