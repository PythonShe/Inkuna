---
// Shared site footer: copyright, support/privacy links, source, and the
// language switcher (stays on the current page's path across locales).
import { getRelativeLocaleUrl } from "astro:i18n";
import { footer } from "../i18n/footer";
import { languages, type Lang } from "../i18n/locales";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
  /** Localized path of the current page, for the language switcher. */
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(footer, lang);
---

<footer>
  <span>© 2026 Inkuna</span>
  <a href={getRelativeLocaleUrl(lang, "/support")}>{t("support")}</a>
  <a href={getRelativeLocaleUrl(lang, "/privacy")}>{t("privacy")}</a>
  <a href="https://github.com/PythonShe/Inkuna">{t("source")}</a>
  <a href="https://github.com/PythonShe/Inkuna/blob/main/LICENSE"
    >{t("license")}</a
  >
  <nav class="lang-switch" aria-label={t("lang")}>
    {
      (Object.entries(languages) as [Lang, string][]).map(([code, label]) => (
        <a
          href={getRelativeLocaleUrl(code, path)}
          lang={code}
          aria-current={code === lang ? "page" : undefined}
        >
          {label}
        </a>
      ))
    }
  </nav>
</footer>

<style>
  footer {
    max-width: 40rem;
    width: 100%;
    margin: 0 auto;
    padding: 2rem 1.5rem 3rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .lang-switch {
    margin-inline-start: auto;
    display: flex;
    gap: 1rem;
  }
  .lang-switch a[aria-current="page"] {
    text-decoration: none;
    color: var(--ink);
  }
</style>
